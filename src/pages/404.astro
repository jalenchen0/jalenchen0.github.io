---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <div class="container page-head" style="padding-block:96px 120px">
    <p class="label">Error 404</p>
    <h1 class="page-title bi" style="margin-top:16px">This node isn’t on the graph.</h1>
    <p class="page-dek">The page you’re looking for doesn’t exist or has moved.</p>
    <div class="hero-actions">
      <a class="btn btn--primary" href="/">back to the graph →</a>
    </div>
  </div>
</Base>
