---
// The hero diagram, generated from src/content/projects. design.md §6, Project graph.
import { getProjects, projectHref } from "../lib/content";

const projects = await getProjects();
const byId = new Map(projects.map((p) => [p.id, p]));
const center = { x: 300, y: 250 };

const labelOffsets = {
  right: { dx: 14, dy: 5, anchor: "start" },
  left: { dx: -14, dy: 5, anchor: "end" },
  "below-right": { dx: 14, dy: 17, anchor: "start" },
} as const;

type Edge = {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  kind: "center" | "tag" | "link";
  ids: string[];
  delay: number;
};

const edges: Edge[] = [];
projects.forEach((p, i) => {
  edges.push({ x1: center.x, y1: center.y, x2: p.data.node.x, y2: p.data.node.y, kind: "center", ids: [p.id], delay: 0.35 + 0.1 * i });
});

let tagIndex = 0;
const tagNodes = projects.flatMap((p) =>
  p.data.tags.map((t) => {
    edges.push({ x1: t.x, y1: t.y, x2: p.data.node.x, y2: p.data.node.y, kind: "tag", ids: [p.id], delay: 0.95 + 0.05 * tagIndex++ });
    return t;
  }),
);

let linkIndex = 0;
const linkLabels: { text: string; x: number; y: number }[] = [];
for (const p of projects) {
  for (const link of p.data.links) {
    const q = byId.get(link.to);
    if (!q) continue;
    edges.push({ x1: p.data.node.x, y1: p.data.node.y, x2: q.data.node.x, y2: q.data.node.y, kind: "link", ids: [p.id, q.id], delay: 1.1 + 0.05 * linkIndex++ });
    if (link.label && link.labelX != null && link.labelY != null) {
      linkLabels.push({ text: link.label, x: link.labelX, y: link.labelY });
    }
  }
}

const nodes = projects.map((p) => ({ project: p, href: projectHref(p), label: labelOffsets[p.data.node.label] }));

// Hovering or focusing a node darkens its own edges. Pure CSS via :has().
const highlightCss = nodes
  .filter((n) => n.href)
  .map((n) => `.graph:has(a.node-${n.project.id}:hover,a.node-${n.project.id}:focus-visible) .edge.e-${n.project.id}{stroke-opacity:1;stroke-width:2.2}`)
  .join("\n");

const names = projects.map((p) => p.data.title).join(", ");
---

<figure class="hero-figure">
  <span class="crop" style="left:-5px;top:-9px" aria-hidden="true">+</span>
  <span class="crop" style="right:-5px;top:-9px" aria-hidden="true">+</span>
  <span class="crop" style="left:-5px;bottom:22px" aria-hidden="true">+</span>
  <span class="crop" style="right:-5px;bottom:22px" aria-hidden="true">+</span>
  <div class="figure-head label" aria-hidden="true">
    <span>Fig. 02</span>
    <span>{projects.length} projects / {edges.length} edges</span>
  </div>
  <svg class="graph" viewBox="0 0 640 480" role="group" aria-label={`Project graph connecting ${names}`}>
    <g aria-hidden="true">
      {
        edges.map((e) => (
          <line
            class:list={["edge", `edge--${e.kind}`, e.ids.map((id) => `e-${id}`), e.kind === "link" ? "bi" : "draw"]}
            x1={e.x1}
            y1={e.y1}
            x2={e.x2}
            y2={e.y2}
            pathLength={e.kind === "link" ? undefined : 1}
            style={`animation-delay:${e.delay.toFixed(2)}s`}
          />
        ))
      }
    </g>
    <g class="bi" style="animation-delay:.2s" aria-hidden="true">
      <circle class="center-dot" cx={center.x} cy={center.y} r="30"></circle>
      <text class="center-text" x={center.x} y={center.y + 5} text-anchor="middle">JC</text>
    </g>
    <g class="bi" style="animation-delay:1.15s" aria-hidden="true">
      {
        tagNodes.map((t) => (
          <>
            <circle class="tag-dot" cx={t.x} cy={t.y} r="3" />
            <text class="t-small" x={t.labelX} y={t.labelY} text-anchor={t.anchor}>
              {t.name}
            </text>
          </>
        ))
      }
      {
        linkLabels.map((l) => (
          <text class="t-small" x={l.x} y={l.y}>
            {l.text}
          </text>
        ))
      }
    </g>
    {
      nodes.map(({ project, href, label }) => {
        const { x, y } = project.data.node;
        const parts = (
          <>
            <circle class="hit" cx={x} cy={y} r="18" fill="transparent" />
            <circle class="ring" cx={x} cy={y} r="13" />
            <circle class="dot" cx={x} cy={y} r="7" />
            <text class="t-node bi" x={x + label.dx} y={y + label.dy} text-anchor={label.anchor} style="animation-delay:.8s">
              {project.data.title}
            </text>
          </>
        );
        return href ? (
          <a href={href} class={`node node-${project.id} bi`} style="animation-delay:.6s" aria-label={`${project.data.title}: ${project.data.description}`}>
            {parts}
          </a>
        ) : (
          <g class="bi" style="animation-delay:.6s" aria-hidden="true">
            {parts}
          </g>
        );
      })
    }
  </svg>
  <figcaption class="figcaption">What I’m building, and how the pieces connect.</figcaption>
  <style is:inline set:html={highlightCss}></style>
</figure>
