---
import { formatDate, tagSlug, type Post } from "../lib/content";

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
const { title, description, date, tags, draft } = post.data;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<article class="post-row">
  <span class="post-row-date">{formatDate(date, "month")}</span>
  <div>
    <Heading class="post-row-title">
      <a class="post-row-link" href={`/writing/${post.id}/`}><span class="smear">{title}</span></a>
    </Heading>
    <p class="post-row-desc">{description}</p>
  </div>
  <div class="chips">
    {draft && <span class="chip">draft</span>}
    {tags.map((tag) => <a class="chip" href={`/tags/${tagSlug(tag)}/`}>{tag}</a>)}
  </div>
</article>
